{
  "manifest_version": 3,
  "name": "CMD + Click To Search",
  "version": "0.1",
  "permissions": ["tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["node_modules/jquery/dist/jquery.slim.js", "content.js"]
    }
  ]
}